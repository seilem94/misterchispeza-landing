# Google Analytics
# Obtener en: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Formspree (formulario de contacto)
# Obtener en: https://formspree.io/
NEXT_PUBLIC_FORMSPREE_ID=

# Cloudflare Turnstile (formulario del Home)
# Obtener en: https://dash.cloudflare.com/
# La site key es pública; debe corresponder al widget configurado en Formspree.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Activar CAPTCHA > Cloudflare Turnstile en los ajustes del formulario de Formspree.
# La Secret Key se configura allí, nunca en NEXT_PUBLIC_ ni en el repositorio.
# Next.js reenvía cf-turnstile-response y Formspree ejecuta Siteverify una sola vez.
# No desactivar la protección nativa ni validar el token antes del reenvío.
# Configuración y prueba de producción: docs/LAUNCH_CHECKLIST.md, D09 y D13.

# URL base del sitio
# Desarrollo: http://localhost:3000
# Producción: https://mrchispeza.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000
