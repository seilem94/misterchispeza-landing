# Google Analytics
# Obtener en: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Formspree (formulario de contacto)
# Obtener en: https://formspree.io/
NEXT_PUBLIC_FORMSPREE_ID=

# Cloudflare Turnstile (formulario del Home)
# Obtener en: https://dash.cloudflare.com/
# La site key es pública; debe corresponder al mismo widget que la secret key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Solo servidor: obligatoria para validar cada envío con Siteverify.
# Nunca usar NEXT_PUBLIC_, publicar la clave ni registrarla en logs.
TURNSTILE_SECRET_KEY=
# El token se valida una sola vez en Next.js y no se reenvía a Formspree.
# Coordinar un receptor protegido compatible; no desactivar controles externos.
# Configuración y prueba de producción: docs/LAUNCH_CHECKLIST.md, D09 y D13.

# URL base del sitio
# Desarrollo: http://localhost:3000
# Producción: https://mrchispeza.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3000
